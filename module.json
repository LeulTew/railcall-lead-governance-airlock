{
  "id": "leultew/lead-governance-airlock",
  "slug": "lead-governance-airlock",
  "name": "Lead Governance Airlock",
  "version": "1.0.0",
  "description": "Governed inbound lead enrichment, deduplication, and AE dispatch for RailCall. contest:2026Q3",
  "author": "LeulTew",
  "tag": "contest:2026Q3",
  "mode": "airlock",
  "risk": "low",
  "license_required": false,
  "publisher": {
    "handle": "LeulTew",
    "signature_alg": "ed25519"
  },
  "authentication": {
    "type": "vault",
    "keys": [
      "HUBSPOT_ACCESS_TOKEN",
      "SLACK_WEBHOOK_URL",
      "AIRTABLE_API_KEY",
      "AIRTABLE_BASE_ID"
    ]
  },
  "egress": {
    "allowed_domains": [
      "api.hubapi.com",
      "hooks.slack.com",
      "api.airtable.com"
    ],
    "external_sockets_enforced": true
  },
  "commands": [
    {
      "id": "validate_lead",
      "title": "Validate Inbound Lead",
      "description": "Validates inbound lead payload, normalizes fields, and detects disposable email domains",
      "side_effects": "none",
      "inputs": [
        {
          "id": "email",
          "title": "Email",
          "type": "string",
          "required": true,
          "description": "Inbound prospect email"
        },
        {
          "id": "name",
          "title": "Name",
          "type": "string",
          "required": false,
          "description": "Full name"
        },
        {
          "id": "company",
          "title": "Company",
          "type": "string",
          "required": false,
          "description": "Company name"
        },
        {
          "id": "title",
          "title": "Title",
          "type": "string",
          "required": false,
          "description": "Job title"
        },
        {
          "id": "message",
          "title": "Message",
          "type": "string",
          "required": false,
          "description": "Inquiry message or request"
        }
      ]
    },
    {
      "id": "check_existing_lead",
      "title": "Deduplicate Lead",
      "description": "Computes SHA-256 idempotency fingerprint and checks against recent triage cache",
      "side_effects": "none",
      "inputs": [
        {
          "id": "data",
          "title": "Lead Object",
          "type": "object",
          "required": true,
          "description": "Validated lead object"
        }
      ]
    },
    {
      "id": "score_lead",
      "title": "Score & Enrich Lead",
      "description": "Enriches profile, calculates ICP lead score (0-100), assigns tier and routing AE",
      "side_effects": "none",
      "inputs": [
        {
          "id": "data",
          "title": "Lead Object",
          "type": "object",
          "required": true,
          "description": "Deduplicated lead object"
        }
      ]
    },
    {
      "id": "preview_airlock",
      "title": "Stage Airlock Preview",
      "description": "Stages structured before/after diffs for operator approval or automated policy sign-off",
      "side_effects": "none",
      "inputs": [
        {
          "id": "data",
          "title": "Lead Object",
          "type": "object",
          "required": true,
          "description": "Scored lead object"
        }
      ]
    },
    {
      "id": "create_hubspot_deal",
      "title": "Create HubSpot Deal",
      "description": "Creates Contact and Deal in HubSpot CRM with dry-run support and rate-limit backoff",
      "side_effects": "external",
      "inputs": [
        {
          "id": "data",
          "title": "Lead Object",
          "type": "object",
          "required": true,
          "description": "Approved lead profile"
        },
        {
          "id": "dry_run",
          "title": "Dry Run",
          "type": "boolean",
          "default": true,
          "description": "Dry-run preview mode"
        }
      ]
    },
    {
      "id": "archive_hubspot_deal",
      "title": "Archive HubSpot Deal (Saga Rollback)",
      "description": "Saga rollback handler to archive HubSpot deal on downstream pipeline failure",
      "side_effects": "external",
      "inputs": [
        {
          "id": "data",
          "title": "Lead Object",
          "type": "object",
          "required": true,
          "description": "Created deal receipt data"
        }
      ]
    },
    {
      "id": "notify_slack_ae",
      "title": "Notify Slack AE",
      "description": "Dispatches rich Block Kit alert card to the sales AE channel",
      "side_effects": "external",
      "inputs": [
        {
          "id": "data",
          "title": "Lead Object",
          "type": "object",
          "required": true,
          "description": "Enriched deal data"
        },
        {
          "id": "dry_run",
          "title": "Dry Run",
          "type": "boolean",
          "default": true,
          "description": "Dry-run preview mode"
        }
      ]
    },
    {
      "id": "log_airtable",
      "title": "Log to Airtable Telemetry",
      "description": "Appends immutable row to Airtable pipeline audit table",
      "side_effects": "external",
      "inputs": [
        {
          "id": "data",
          "title": "Lead Object",
          "type": "object",
          "required": true,
          "description": "Enriched deal data"
        },
        {
          "id": "dry_run",
          "title": "Dry Run",
          "type": "boolean",
          "default": true,
          "description": "Dry-run preview mode"
        }
      ]
    }
  ],
  "manifest_version": 2,
  "publisher_pubkey": "11123e75b7a2ea8753b2b1695aac0d59b2af41ae5caa4d25035f4c53d51d0418"
}
