# RailCall Lead Governance Airlock - Environment Configuration
# Copy this file to .env or configure in RailCall Studio -> Integrations

# HubSpot CRM API (Required for live execution)
# Generate a Private App token in HubSpot Settings -> Integrations -> Private Apps
# Required Scopes: crm.objects.contacts.write, crm.objects.deals.write
HUBSPOT_ACCESS_TOKEN=

# Slack Incoming Webhook (Required for live AE alerts)
# Configure via Slack App Directory -> Incoming Webhooks
SLACK_WEBHOOK_URL=

# Airtable API (Optional secondary telemetry sink)
# Generate Personal Access Token at airtable.com/create/tokens
# Required Scopes: data.records:write
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Inbound Leads

# RailCall Station Configuration
RC_STATION_URL=http://127.0.0.1:8799
RC_DRY_RUN=true
